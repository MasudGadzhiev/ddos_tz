SHELL         := /usr/bin/env bash
.SHELLFLAGS   := -euo pipefail -c
.DEFAULT_GOAL := help

VENV ?= .venv
BIN       := $(if $(wildcard $(VENV)/bin/ansible-playbook),$(VENV)/bin/,)
PLAYBOOK  := $(BIN)ansible-playbook
ANSIBLE   := $(BIN)ansible
GALAXY    := $(BIN)ansible-galaxy
LINT      := $(BIN)ansible-lint
YAMLLINT  := $(BIN)yamllint

INV := inventory/hosts.yml
ARGS ?=
MONITORING_HOST ?= monitoring-1
BOOTSTRAP_USER ?= root
SSH_PUBLIC_KEY_FILE ?= $(HOME)/.ssh/id_ed25519.pub

.PHONY: help up venv deps bootstrap ping provision check idempotency verify test load \
        reboot-test lint grafana-password ui clean

help: ## Show this help
	@awk 'BEGIN {FS = ":.*## "} /^[a-zA-Z_-]+:.*## / {printf "  \033[36m%-18s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

up: bootstrap provision verify ## Configure fresh VMs end to end and run the acceptance checks

$(INV):
	@echo "$(INV) is missing: cp inventory/hosts.example.yml $(INV) and fill in the IPs." >&2; exit 1

venv: ## Create .venv with the pinned Python tooling (requires uv)
	uv venv --python 3.13 $(VENV)
	uv pip install --python $(VENV)/bin/python -r requirements.txt

deps: ## Install Ansible collections into ./collections
	$(GALAXY) collection install -r requirements.yml -p collections

bootstrap: $(INV) ## Create the non-root automation user as root (skips hosts already done)
	$(PLAYBOOK) bootstrap.yml -e ansible_user=$(BOOTSTRAP_USER) \
		-e bootstrap_ssh_public_key_file=$(SSH_PUBLIC_KEY_FILE)

ping: $(INV) ## Check SSH and sudo on all hosts
	$(ANSIBLE) all -m ansible.builtin.ping --become

provision: $(INV) ## Apply site.yml
	$(PLAYBOOK) site.yml $(ARGS)

check: $(INV) ## Dry run: show what would change (--check --diff)
	$(PLAYBOOK) site.yml --check --diff $(ARGS)

idempotency: $(INV) ## Run site.yml again and fail unless every host reports changed=0
	@mkdir -p .cache
	$(PLAYBOOK) site.yml $(ARGS) | tee .cache/idempotency.log
	@if grep -qE 'changed=[1-9]' .cache/idempotency.log; then \
		echo "FAIL: the second run changed something"; exit 1; \
	else echo "OK: changed=0 on all hosts"; fi

verify: $(INV) ## Acceptance checks: iperf3 tunnel vs direct, Prometheus targets, Grafana
	$(PLAYBOOK) verify.yml

test: lint verify ## Lint and acceptance checks

load: $(INV) ## 2 minutes of iperf3 through the tunnel - watch the "ceiling" in Grafana
	$(ANSIBLE) 'iperf_servers[0]' -m ansible.builtin.command \
		-a "iperf3 --client {{ hostvars[tunnel_peer]['tunnel_ip'] }} --time 120 --interval 10"

reboot-test: $(INV) ## Reboot the iperf servers, then check tunnel and tc came back
	$(ANSIBLE) iperf_servers --become -m ansible.builtin.reboot
	$(PLAYBOOK) verify.yml

lint: ## yamllint, ansible-lint and syntax check
	$(YAMLLINT) --strict .
	$(LINT)
	$(PLAYBOOK) site.yml verify.yml bootstrap.yml --syntax-check

grafana-password: ## Print the generated Grafana admin password
	@test -r "$(CURDIR)/.credentials/grafana_admin_password" \
		|| { echo "No password yet: it is generated by the first 'make provision'." >&2; exit 1; }
	@cat "$(CURDIR)/.credentials/grafana_admin_password" && echo

ui: $(INV) ## SSH tunnel to the UIs: Grafana http://localhost:3000, Prometheus http://localhost:9090
	@target=$$($(ANSIBLE) $(MONITORING_HOST) -o -m ansible.builtin.debug \
		-a 'msg={{ ansible_user }}@{{ ansible_host }}' 2>/dev/null | sed -n 's/.*"msg": "\([^"]*\)".*/\1/p'); \
	test -n "$$target" || { echo "Cannot resolve $(MONITORING_HOST) from the inventory." >&2; exit 1; }; \
	echo "Grafana:    http://localhost:3000  (admin / make grafana-password)"; \
	echo "Prometheus: http://localhost:9090"; \
	echo "Ctrl+C closes the tunnel."; \
	ssh -N -o ExitOnForwardFailure=yes -L 3000:127.0.0.1:3000 -L 9090:127.0.0.1:9090 "$$target"

clean: ## Remove locally installed collections and caches
	rm -rf collections .cache
