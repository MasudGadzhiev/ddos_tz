{{ ansible_managed | comment }}
global:
  scrape_interval: {{ monitoring_scrape_interval }}
  scrape_timeout: {{ monitoring_scrape_timeout }}
  evaluation_interval: {{ monitoring_evaluation_interval }}

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node
    static_configs:
{% for name, address in monitoring_node_targets | dictsort %}
      - targets: ["{{ address }}"]
        labels:
          instance: {{ name }}
{% endfor %}
